# Collected Static & User Uploaded Media
staticfiles/
media/
!staticfiles/.gitkeep
!media/.gitkeep

# ==========================================
# Geospatial Data & Heavy Spatial Rasters
# ==========================================
# Ignore raw GIS layers, GeoTIFFs, and Shapefiles to keep git lightweight
*.tif
*.tiff
*.nc
*.hdf
*.mbtiles
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson

# Spatial Data Working Directories
data/raw/*
data/processed/*
data/exports/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ==========================================
# Celery & Asynchronous Tasks
# ==========================================
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# ==========================================
# IDEs & System Garbage
# ==========================================
